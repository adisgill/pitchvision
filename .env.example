# Copy to .env (gitignored). Never commit real keys.
# Kaggle API token (https://www.kaggle.com/settings -> API)
KAGGLE_USERNAME=
KAGGLE_KEY=
# football-data.org free-tier key (register at https://www.football-data.org/client/register)
FOOTBALL_DATA_ORG_KEY=
# Optional: where data/ lives (default: <repo>/data)
PITCHVISION_DATA_DIR=
